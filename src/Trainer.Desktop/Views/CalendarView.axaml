<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Trainer.Desktop.Controls"
             x:Class="Trainer.Desktop.Views.CalendarView">
    <UserControl.Styles>
        <Style Selector="Border.day">
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="5,4" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
            <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
        </Style>
        <Style Selector="Border.day.other"><Setter Property="Opacity" Value="0.55" /></Style>
        <Style Selector="Border.day.blocked"><Setter Property="Background" Value="{StaticResource Brush.Blocked}" /></Style>
        <Style Selector="Border.day.today">
            <Setter Property="Background" Value="{StaticResource Brush.Today}" />
            <Setter Property="BorderBrush" Value="#E9B949" />
        </Style>
        <Style Selector="Border.day.drop"><Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" /><Setter Property="BorderThickness" Value="2" /></Style>
        <Style Selector="Border.chip.skipped">
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="BorderBrush" Value="#C9D1D7" />
        </Style>
        <Style Selector="Border.chip">
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <!-- Toolbar -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Regenerate plan" Command="{Binding RegenerateCommand}" ToolTip.Tip="Re-run the plan engine from today" />
                <Button Content="Week to ZWO…" Command="{Binding ExportWeekToZwoCommand}" ToolTip.Tip="Save the next 7 days as Zwift .zwo workout files" />
                <Button Content="Send week to Edge" Classes="primary" Command="{Binding SendWeekToEdgeCommand}" Margin="0"
                        ToolTip.Tip="Export the next 7 days as FIT files to the Garmin Edge" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="‹" Command="{Binding PreviousCommand}" Width="36" HorizontalContentAlignment="Center" />
                <Button Content="Today" Command="{Binding GoTodayCommand}" />
                <Button Content="›" Command="{Binding NextCommand}" Width="36" HorizontalContentAlignment="Center" />
                <TextBlock Text="{Binding Heading}" Classes="h1" Margin="8,0,16,0" VerticalAlignment="Center" />
                <RadioButton Content="Month" IsChecked="{Binding MonthMode}" GroupName="calmode" Margin="0,0,8,0" />
                <RadioButton Content="Week" IsChecked="{Binding WeekMode}" GroupName="calmode" />
            </StackPanel>
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" Text="{Binding WeekSummary}" Classes="muted" Margin="2,0,0,6" />
        <Border DockPanel.Dock="Top" Classes="banner" IsVisible="{Binding Notes, Converter={StaticResource HasValue}}">
            <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" />
        </Border>
        <TextBlock DockPanel.Dock="Bottom" Classes="muted" FontSize="11" Margin="2,6,0,0"
                   Text="Double-click a workout to open it · drag it to another day to move it · right-click to move, remove or restore a workout, or to block a day.   Green = done · amber = partial · red = missed." />

        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,170" Margin="0,0,0,2">
        <TextBlock Grid.Column="1" Text="Week" Classes="muted" Margin="8,0" />
        <UniformGrid Columns="7">
            <TextBlock Text="Mon" Classes="muted" Margin="6,0" />
            <TextBlock Text="Tue" Classes="muted" Margin="6,0" />
            <TextBlock Text="Wed" Classes="muted" Margin="6,0" />
            <TextBlock Text="Thu" Classes="muted" Margin="6,0" />
            <TextBlock Text="Fri" Classes="muted" Margin="6,0" />
            <TextBlock Text="Sat" Classes="muted" Margin="6,0" />
            <TextBlock Text="Sun" Classes="muted" Margin="6,0" />
        </UniformGrid>
        </Grid>

        <!-- One row per week: seven days, then the week's totals. -->
        <ItemsControl ItemsSource="{Binding Weeks}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                <Grid ColumnDefinitions="*,170">
                <Border Grid.Column="1" Margin="2" Padding="8,6" CornerRadius="5" BorderThickness="1" BorderBrush="{StaticResource Brush.Border}"
                        Background="#F8FAFB" ToolTip.Tip="{Binding Tooltip}">
                    <StackPanel Spacing="2">
                        <Border CornerRadius="3" Padding="5,1" HorizontalAlignment="Left" IsVisible="{Binding Plan, Converter={StaticResource HasValue}}"
                                Background="{Binding Plan.Phase, Converter={StaticResource PhaseBrush}}">
                            <TextBlock Text="{Binding PhaseLabel}" FontSize="10" Foreground="White" />
                        </Border>
                        <TextBlock Text="Prescribed" FontSize="10" Foreground="{StaticResource Brush.Muted}" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding PlannedText}" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="Done" FontSize="10" Foreground="{StaticResource Brush.Muted}" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding DoneText}" FontSize="12" FontWeight="SemiBold" Foreground="#226B3D" />
                        <Grid IsVisible="{Binding Started}" Margin="0,3,0,0">
                            <ProgressBar Value="{Binding DoneFraction}" Maximum="1.2" Height="12" MinWidth="0" Foreground="#3FAE6A" Background="#E3E8EC" />
                            <TextBlock Text="{Binding PercentText}" FontSize="9.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding Days}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="7" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Classes="day" Classes.today="{Binding IsToday}" Classes.blocked="{Binding IsBlocked}" Classes.other="{Binding IsOtherMonth}"
                            DragDrop.AllowDrop="True">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding DayLabel}" FontSize="12" FontWeight="SemiBold" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <TextBlock Text="{Binding Blocked.Reason, StringFormat='⛔ {0}'}" FontSize="11" Foreground="{StaticResource Brush.Muted}"
                                               IsVisible="{Binding IsBlocked}" TextTrimming="CharacterEllipsis" />
                                    <ItemsControl ItemsSource="{Binding Races}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,2,0,0" Background="#FDE7E9" BorderBrush="#E35D6A" BorderThickness="1" CornerRadius="4" Padding="5,2"
                                                        ToolTip.Tip="{Binding Tooltip}">
                                                    <TextBlock Text="{Binding Label, StringFormat='🏁 {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="#9C2433" TextTrimming="CharacterEllipsis" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding Workouts}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Classes="chip" Classes.skipped="{Binding IsSkipped}" ToolTip.Tip="{Binding Tooltip}">
                                                    <DockPanel>
                                                        <Border DockPanel.Dock="Left" Width="4" CornerRadius="4,0,0,4" Background="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                                        <StackPanel Margin="5,3,4,3">
                                                            <DockPanel>
                                                                <TextBlock DockPanel.Dock="Right" Text="🔒" FontSize="10" IsVisible="{Binding Locked}" />
                                                                <TextBlock DockPanel.Dock="Right" Text="☀ " FontSize="10" IsVisible="{Binding Outdoor}" />
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                                            </DockPanel>
                                                            <TextBlock Text="{Binding Summary}" FontSize="10.5" Foreground="{StaticResource Brush.Muted}" />
                                                            <c:IntervalGraph Steps="{Binding Steps}" Compact="True" Height="16" Margin="0,2,0,0" IsHitTestVisible="False" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding Activities}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,2,0,0" Background="#E5F4EA" CornerRadius="4" Padding="5,2" ToolTip.Tip="{Binding Tooltip}">
                                                    <TextBlock Text="{Binding Label}" FontSize="10.5" Foreground="#226B3D" TextTrimming="CharacterEllipsis" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </DataTemplate>
                </ItemsControl.ItemTemplate>
                </ItemsControl>
                </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</UserControl>
