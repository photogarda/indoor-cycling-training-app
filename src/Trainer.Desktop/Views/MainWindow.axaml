<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Trainer.Desktop.Views.MainWindow"
        Title="Cycling Training Planner" Width="1360" Height="860" MinWidth="1000" MinHeight="640"
        Icon="avares://Trainer/Assets/icon.png"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Brush.Background}">
    <Grid ColumnDefinitions="210,*">
        <!-- Left-hand menu -->
        <DockPanel Background="{DynamicResource Brush.Nav}">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,18,12,22" Spacing="10">
                <Image Source="avares://Trainer/Assets/icon.png" Width="38" Height="38" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Training Planner" Foreground="White" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="Base · Build · Specialty" Foreground="{DynamicResource Brush.NavText}" FontSize="11" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>
            <DockPanel DockPanel.Dock="Bottom" Margin="16,8,12,12">
                <Button DockPanel.Dock="Right" Classes="theme" Content="{Binding ThemeIcon}" Command="{Binding ToggleThemeCommand}"
                        ToolTip.Tip="{Binding ThemeTip}" />
                <TextBlock Foreground="{DynamicResource Brush.NavText}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"
                           Text="{Binding Version}" />
            </DockPanel>
            <ListBox Classes="nav" ItemsSource="{Binding Nav}" SelectedItem="{Binding SelectedNav}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Screen -->
        <Grid Grid.Column="1">
            <ContentControl Content="{Binding Current}" Margin="24,20,24,16" />

            <!-- Toast -->
            <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,24" Padding="16,10" CornerRadius="6"
                    Background="{DynamicResource Brush.Toast}" IsVisible="{Binding ToastText, Converter={StaticResource HasValue}}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{Binding ToastText}" Foreground="White" MaxWidth="700" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button Content="✕" Command="{Binding DismissToastCommand}" Padding="6,0" Background="Transparent" Foreground="White" />
                </StackPanel>
            </Border>

            <!-- Busy overlay -->
            <Grid Background="{DynamicResource Brush.Overlay}" IsVisible="{Binding IsBusy}">
                <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                        CornerRadius="6" Padding="24,16" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Spacing="10">
                        <ProgressBar IsIndeterminate="True" Width="220" />
                        <TextBlock Text="{Binding BusyText}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
                        <Button Content="Stop" Command="{Binding CancelBusyCommand}" IsVisible="{Binding CanCancelBusy}"
                                HorizontalAlignment="Center" Margin="0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
