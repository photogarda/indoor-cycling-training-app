<Window x:Class="Trainer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cycling Training Planner" Height="860" Width="1360" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Brush.Background}"
        FontFamily="Segoe UI" FontSize="13">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left-hand menu -->
        <DockPanel Background="{StaticResource Brush.Nav}">
            <StackPanel DockPanel.Dock="Top" Margin="18,20,18,24">
                <TextBlock Text="Training Planner" Foreground="White" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="Base · Build · Specialty" Foreground="{StaticResource Brush.NavText}" FontSize="11" Margin="0,2,0,0" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Bottom" Margin="18,12" Foreground="{StaticResource Brush.NavText}" FontSize="11" TextWrapping="Wrap"
                       Text="{Binding Current.Title, StringFormat='Showing: {0}'}" />
            <ListBox Style="{StaticResource NavList}" ItemsSource="{Binding Nav}" SelectedItem="{Binding SelectedNav}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                       Width="26" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Label}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" FontSize="14" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Screen -->
        <Grid Grid.Column="1">
            <ContentControl Content="{Binding Current}" Margin="24,20,24,16" Focusable="False" />

            <!-- Toast -->
            <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,24" Padding="16,10" CornerRadius="6"
                    Background="#E61E2A33" Visibility="{Binding ToastText, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ToastText}" Foreground="White" MaxWidth="700" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button Content="✕" Command="{Binding DismissToastCommand}" Margin="12,0,0,0" Padding="6,0" MinHeight="0"
                            Background="Transparent" BorderThickness="0" Foreground="White" />
                </StackPanel>
            </Border>

            <!-- Busy overlay -->
            <Grid Background="#66FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                <Border Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                        CornerRadius="6" Padding="24,16" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <ProgressBar IsIndeterminate="True" Width="220" Height="4" Margin="0,0,0,10" />
                        <TextBlock Text="{Binding BusyText}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
