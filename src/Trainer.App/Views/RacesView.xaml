<UserControl x:Class="Trainer.App.Views.RacesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Races" Style="{StaticResource H1}" />
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,0,0,12"
                   Text="The plan counts base, build, specialty and taper back from each A race. B races get a 3-day mini taper; C races count as that week's hardest session. A races must be at least 3 months apart." />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>
            <DataGrid ItemsSource="{Binding Races}" SelectedItem="{Binding Selected}" Margin="0,0,16,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="130" />
                    <DataGridTextColumn Header="" Binding="{Binding Countdown}" Width="90" />
                    <DataGridTextColumn Header="Race" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="110" />
                    <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="60" />
                    <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="70" />
                    <DataGridTextColumn Header="Intensity" Binding="{Binding Intensity}" Width="70" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource H2}" />
                    <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Date" Style="{StaticResource FieldLabel}" />
                    <DatePicker SelectedDate="{Binding Date}" />
                    <TextBlock Text="Event type" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding EventTypes}" SelectedValue="{Binding Type}" SelectedValuePath="Key" DisplayMemberPath="Value" />
                    <TextBlock Text="Priority" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Priorities}" SelectedItem="{Binding Priority}" />
                    <TextBlock Style="{StaticResource FieldLabel}">
                        <Run Text="Duration:" /> <Run Text="{Binding DurationHours, StringFormat='0.0# h', Mode=OneWay}" />
                    </TextBlock>
                    <Slider Minimum="0.5" Maximum="12" TickFrequency="0.25" IsSnapToTickEnabled="True" Value="{Binding DurationHours}" />
                    <TextBlock Style="{StaticResource FieldLabel}">
                        <Run Text="Intensity:" /> <Run Text="{Binding Intensity, Mode=OneWay}" /><Run Text="/10 (1–3 steady, 4–7 mixed, 8–10 very hard)" />
                    </TextBlock>
                    <Slider Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight" Value="{Binding Intensity}" />
                    <Border Style="{StaticResource Banner}" Margin="0,12,0,0" Visibility="{Binding Validation, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Validation}" TextWrapping="Wrap" Foreground="#7A5600" />
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" MinWidth="80" />
                        <Button Content="New" Command="{Binding NewCommand}" />
                        <Button Content="Delete" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
