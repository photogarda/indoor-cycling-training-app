<UserControl x:Class="Trainer.App.Views.AnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Show last" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource Muted}" />
                <ComboBox ItemsSource="{Binding Ranges}" SelectedItem="{Binding RangeDays}" Width="80" ItemStringFormat="{}{0} days" />
            </StackPanel>
            <TextBlock Text="Analysis" Style="{StaticResource H1}" Margin="0" VerticalAlignment="Center" />
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding FormText}" Margin="0,0,0,10" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Grid.ColumnSpan="2" Style="{StaticResource Card}" Padding="4">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Performance management (CTL fitness · ATL fatigue · TSB form)" Style="{StaticResource H2}" Margin="10,6,0,0" />
                    <sp:WpfPlot x:Name="Pmc" />
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4" Margin="0,0,12,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="10,6,6,0">
                        <Button DockPanel.Dock="Right" Content="Use estimate as FTP" Command="{Binding UseEstimateCommand}" Margin="0"
                                Visibility="{Binding Estimate, Converter={StaticResource BoolToVis}}" />
                        <StackPanel>
                            <TextBlock Text="Power curve: last 6 weeks vs all time" Style="{StaticResource H2}" Margin="0" />
                            <TextBlock Text="{Binding FtpText}" Style="{StaticResource Muted}" FontSize="11" />
                        </StackPanel>
                    </DockPanel>
                    <sp:WpfPlot x:Name="Curve" />
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Weekly compliance" Style="{StaticResource H2}" />
                    <DataGrid ItemsSource="{Binding Compliance}" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Week" Binding="{Binding Week}" Width="60" />
                            <DataGridTextColumn Header="Plan" Binding="{Binding Planned}" Width="50" />
                            <DataGridTextColumn Header="Actual" Binding="{Binding Actual}" Width="55" />
                            <DataGridTemplateColumn Header="%" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <ProgressBar Value="{Binding Fraction, Mode=OneWay}" Maximum="1.2" Height="14" Foreground="#3FAE6A" Background="#ECEFF2" BorderThickness="0" />
                                            <TextBlock Text="{Binding Percent}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Workouts" Binding="{Binding Workouts}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
