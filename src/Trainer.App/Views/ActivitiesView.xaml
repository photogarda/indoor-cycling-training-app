<UserControl x:Class="Trainer.App.Views.ActivitiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Import from Edge" Style="{StaticResource PrimaryButton}" Command="{Binding ImportFromEdgeCommand}" />
                <Button Content="Import FIT files…" Command="{Binding ImportFilesCommand}" />
                <Button Content="Sync Strava" Command="{Binding SyncStravaCommand}" />
                <Button Content="Open FIT folder" Command="{Binding OpenFitFolderCommand}" Margin="0" />
            </StackPanel>
            <TextBlock Text="Activities" Style="{StaticResource H1}" Margin="0" VerticalAlignment="Center" />
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Style="{StaticResource Muted}" Margin="0,0,0,10" />

        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="{Binding Selected, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="Linked planned workout:" VerticalAlignment="Center" Margin="0,0,10,0" />
                <Button DockPanel.Dock="Right" Content="Delete ride" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}" Margin="0" />
                <Button DockPanel.Dock="Right" Content="Link" Command="{Binding LinkCommand}" />
                <ComboBox ItemsSource="{Binding LinkOptions}" SelectedItem="{Binding SelectedLink}" DisplayMemberPath="Label" Margin="0,0,8,0" />
            </DockPanel>
        </Border>

        <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Start" Binding="{Binding Date}" Width="150" />
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="90" />
                <DataGridTextColumn Header="Time" Binding="{Binding Duration}" Width="60" />
                <DataGridTextColumn Header="Distance" Binding="{Binding Distance}" Width="75" />
                <DataGridTextColumn Header="Avg / NP" Binding="{Binding Power}" Width="95" />
                <DataGridTextColumn Header="IF" Binding="{Binding If}" Width="45" />
                <DataGridTextColumn Header="TSS" Binding="{Binding Tss}" Width="65" />
                <DataGridTextColumn Header="HR" Binding="{Binding Hr}" Width="45" />
                <DataGridTextColumn Header="Cad" Binding="{Binding Cadence}" Width="45" />
                <DataGridTextColumn Header="Planned workout" Binding="{Binding LinkedTo}" Width="220" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
