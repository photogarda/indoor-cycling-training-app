<UserControl x:Class="Trainer.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Trainer.App.Controls">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Settings" Style="{StaticResource H1}" />

        <Border DockPanel.Dock="Top" Style="{StaticResource Banner}" Visibility="{Binding ShowWelcome, Converter={StaticResource BoolToVis}}">
            <TextBlock TextWrapping="Wrap">
                <Run FontWeight="SemiBold" Text="Welcome!" />
                <Run Text="Set your weekly hours and training days below, then enter an FTP you know (e.g. from a recent test). Don't know it? Type a rough guess and choose 'Start with a ramp test': the plan opens with a test and sets your real FTP from it." />
            </TextBlock>
        </Border>

        <TabControl Background="Transparent" BorderThickness="0" Padding="0,10,0,0">
            <!-- Athlete and FTP -->
            <TabItem Header="Athlete &amp; FTP">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="520" />
                            <ColumnDefinition Width="*" MaxWidth="520" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,12,12" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Athlete" Style="{StaticResource H2}" />
                                <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Name}" />
                                <TextBlock Text="Level (sets weekly load ramp and interval volume)" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding Level}" />
                                <TextBlock Style="{StaticResource FieldLabel}">
                                    <Run Text="Weekly hours:" /> <Run Text="{Binding WeeklyHours, StringFormat='0.# h', Mode=OneWay}" />
                                </TextBlock>
                                <Slider Minimum="2" Maximum="25" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding WeeklyHours}" />
                                <TextBlock Text="Training days" Style="{StaticResource FieldLabel}" />
                                <ItemsControl ItemsSource="{Binding Days}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Label}" IsChecked="{Binding Selected}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Long-ride day" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding WeekDays}" SelectedItem="{Binding LongRideDay}" />
                                <TextBlock Text="With no race on the calendar, work on" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding Goals}" SelectedItem="{Binding NoRaceGoal}" />
                                <TextBlock Text="Threshold heart rate (for rides without power)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding ThresholdHr}" Width="100" HorizontalAlignment="Left" />
                                <CheckBox Content="New workouts are indoor (ERG) by default" IsChecked="{Binding DefaultIndoor}" Margin="0,10,0,0" />
                                <Button Content="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveAthleteCommand}" HorizontalAlignment="Left" Margin="0,14,0,0" MinWidth="90" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="FTP" Style="{StaticResource H2}" />
                                <TextBlock Text="{Binding CurrentFtpText}" Style="{StaticResource Muted}" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Watts" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding NewFtp, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0">
                                        <TextBlock Text="From" Style="{StaticResource FieldLabel}" />
                                        <ComboBox ItemsSource="{Binding Methods}" SelectedItem="{Binding NewFtpMethod}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Date" Style="{StaticResource FieldLabel}" />
                                        <DatePicker SelectedDate="{Binding NewFtpDate}" />
                                    </StackPanel>
                                </Grid>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="Save FTP" Style="{StaticResource PrimaryButton}" Command="{Binding AddFtpCommand}" Margin="0,0,8,6" />
                                    <Button Content="Estimate from rides" Command="{Binding EstimateFtpCommand}" Margin="0,0,8,6"
                                            ToolTip="95 % of your best 20 minutes in the last 6 weeks" />
                                    <Button Content="Start with a ramp test" Command="{Binding StartWithRampTestCommand}" Margin="0,0,8,6"
                                            Visibility="{Binding ShowWelcome, Converter={StaticResource BoolToVis}}" />
                                </WrapPanel>
                                <TextBlock Text="History" Style="{StaticResource FieldLabel}" Margin="0,12,0,3" />
                                <DataGrid ItemsSource="{Binding FtpHistory}" SelectedItem="{Binding SelectedFtp}" MaxHeight="220">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="*" />
                                        <DataGridTextColumn Header="FTP" Binding="{Binding Watts}" Width="70" />
                                        <DataGridTextColumn Header="From" Binding="{Binding Method}" Width="90" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Button Content="Delete selected" Style="{StaticResource DangerButton}" Command="{Binding DeleteFtpCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                                <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0"
                                           Text="Workouts are stored as % FTP. Watts are worked out when a workout is exported, from the FTP on its date, so a new FTP updates every future workout. A ride linked to a planned ramp test sets FTP automatically (75 % of the best minute)." />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- Edge, watched folder, Strava -->
            <TabItem Header="Edge &amp; Strava">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Garmin Edge (USB)" Style="{StaticResource H2}" />
                                <TextBlock Style="{StaticResource Muted}"
                                           Text="Workouts go to Garmin\NewFiles; the Edge imports them when unplugged and runs them in ERG. Rides are read from Garmin\Activity. Newer Edges connect as MTP devices and are found automatically; for a drive letter you can set it here." />
                                <TextBlock Text="Drive or folder (optional)" Style="{StaticResource FieldLabel}" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Detect" Command="{Binding DetectEdgeCommand}" Margin="8,0,0,0" />
                                    <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseEdgeCommand}" Margin="8,0,0,0" />
                                    <TextBox Text="{Binding EdgePath}" />
                                </DockPanel>
                                <TextBlock Text="{Binding EdgeStatus}" Style="{StaticResource Muted}" Margin="0,6,0,0" />
                                <TextBlock Text="Watched folder for downloaded FIT files (e.g. from Garmin Connect)" Style="{StaticResource FieldLabel}" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseWatchFolderCommand}" Margin="8,0,0,0" />
                                    <TextBox Text="{Binding WatchFolder}" />
                                </DockPanel>
                                <Button Content="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveDevicesCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" MinWidth="90" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Strava" Style="{StaticResource H2}" />
                                <TextBlock Style="{StaticResource Muted}">
                                    <Run Text="Create your own API application at strava.com/settings/api with Authorization Callback Domain" />
                                    <Run Text="localhost" FontWeight="SemiBold" /><Run Text=", then paste its Client ID and Client Secret here. Rides already imported from the Edge are skipped; FIT files win over Strava." />
                                </TextBlock>
                                <Button Content="Open Strava API settings" Command="{Binding OpenStravaApiPageCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                                <TextBlock Text="Client ID" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding StravaClientId}" Width="200" HorizontalAlignment="Left" />
                                <TextBlock Text="Client Secret" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding StravaClientSecret}" />
                                <TextBlock Text="{Binding StravaStatus}" Margin="0,10,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Connect" Style="{StaticResource PrimaryButton}" Command="{Binding ConnectStravaCommand}" />
                                    <Button Content="Disconnect" Command="{Binding DisconnectStravaCommand}" Visibility="{Binding StravaConnected, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Workout library editor -->
            <TabItem Header="Workout library">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Margin="0,0,12,0">
                        <TextBox DockPanel.Dock="Top" Text="{Binding LibraryFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" ToolTip="Filter by name or type" />
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="New" Command="{Binding NewTemplateCommand}" />
                            <Button Content="Duplicate" Command="{Binding DuplicateTemplateCommand}" />
                            <Button Content="Export ZWO…" Command="{Binding ExportTemplateZwoCommand}" Margin="0" />
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,6,0" Background="{Binding Kind, Converter={StaticResource KindBrush}}" />
                                        <TextBlock Text="{Binding Name}" />
                                        <TextBlock Text=" (mine)" Style="{StaticResource Muted}" Visibility="{Binding BuiltIn, Converter={StaticResource BoolToVisInv}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Built-in workouts are read-only: duplicate one to make your own version." Style="{StaticResource Muted}"
                                           Visibility="{Binding TemplateEditable, Converter={StaticResource BoolToVisInv}}" Margin="0,0,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="200" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding TemplateName}" IsReadOnly="{Binding TemplateEditable, Converter={x:Static c:Not.Instance}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Type (used by the plan engine)" Style="{StaticResource FieldLabel}" />
                                        <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding TemplateKind}" IsEnabled="{Binding TemplateEditable}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Intervals" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding TemplateNotation, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"
                                         FontFamily="Consolas" IsReadOnly="{Binding TemplateEditable, Converter={x:Static c:Not.Instance}}" />
                                <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"
                                           Text="Steps separated by ; — [wu|cd|rec|fill|free] duration power% [&quot;label&quot;]. Durations 30s, 10m, 1h30m. Power 95 or 88-94 (% FTP). Repeats: 3x(10m 95, 5m 55). 'fill' stretches to the planned length; 'free' is ERG off." />
                                <TextBlock Text="{Binding TemplateError}" Foreground="{StaticResource Brush.Danger}" Margin="0,6,0,0"
                                           Visibility="{Binding TemplateError, Converter={StaticResource BoolToVis}}" TextWrapping="Wrap" />
                                <c:IntervalGraph Steps="{Binding TemplatePreview}" Ftp="{Binding PreviewFtp}" Height="160" Margin="0,10,0,0" />
                                <TextBlock Text="{Binding TemplateStats}" Style="{StaticResource Muted}" Margin="0,6,0,0" />
                                <TextBlock Text="Description" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding TemplateDescription}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44"
                                         IsReadOnly="{Binding TemplateEditable, Converter={x:Static c:Not.Instance}}" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0" Visibility="{Binding TemplateEditable, Converter={StaticResource BoolToVis}}">
                                    <Button Content="Save workout" Style="{StaticResource PrimaryButton}" Command="{Binding SaveTemplateCommand}" />
                                    <Button Content="Delete" Style="{StaticResource DangerButton}" Command="{Binding DeleteTemplateCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Data -->
            <TabItem Header="Data">
                <Border Style="{StaticResource Card}" VerticalAlignment="Top" MaxWidth="760" HorizontalAlignment="Left">
                    <StackPanel>
                        <TextBlock Text="Your data" Style="{StaticResource H2}" />
                        <TextBlock Style="{StaticResource Muted}" Text="Everything lives in one folder: trainer.db (SQLite) and the fit folder of imported rides. Backing up is copying that folder; the buttons below zip it for you." />
                        <TextBlock Text="{Binding DataFolder}" FontFamily="Consolas" Margin="0,10,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Open folder" Command="{Binding OpenDataFolderCommand}" />
                            <Button Content="Back up…" Style="{StaticResource PrimaryButton}" Command="{Binding BackupCommand}" />
                            <Button Content="Restore…" Style="{StaticResource DangerButton}" Command="{Binding RestoreCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
