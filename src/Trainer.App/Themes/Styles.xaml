<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:infra="clr-namespace:Trainer.App.Infrastructure">

    <!-- Colours -->
    <SolidColorBrush x:Key="Brush.Background" Color="#F3F5F7" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Border" Color="#DCE2E7" />
    <SolidColorBrush x:Key="Brush.Text" Color="#1E2A33" />
    <SolidColorBrush x:Key="Brush.Muted" Color="#6A7884" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#2563A8" />
    <SolidColorBrush x:Key="Brush.AccentLight" Color="#E2EDF8" />
    <SolidColorBrush x:Key="Brush.Nav" Color="#1C2731" />
    <SolidColorBrush x:Key="Brush.NavText" Color="#C5D0D9" />
    <SolidColorBrush x:Key="Brush.Today" Color="#FFF6DA" />
    <SolidColorBrush x:Key="Brush.Blocked" Color="#ECEFF2" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#C53B3B" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#FFF3CD" />

    <!-- Converters -->
    <infra:BoolToVisibilityConverter x:Key="BoolToVis" />
    <infra:BoolToVisibilityConverter x:Key="BoolToVisInv" Invert="True" />
    <infra:StatusBrushConverter x:Key="StatusBrush" />
    <infra:KindBrushConverter x:Key="KindBrush" />
    <infra:PhaseBrushConverter x:Key="PhaseBrush" />
    <infra:DurationConverter x:Key="Duration" />

    <!-- Text -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    </Style>
    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Brush.Muted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Brush.Muted}" />
        <Setter Property="Margin" Value="0,8,0,3" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Surfaces -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style x:Key="Banner" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Warning}" />
        <Setter Property="BorderBrush" Value="#F0D88A" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- Inputs -->
    <Style TargetType="Button">
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="5,4" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="MinHeight" Value="28" />
    </Style>
    <Style TargetType="DatePicker">
        <Setter Property="Padding" Value="4,3" />
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Margin" Value="0,0,12,4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
        <Setter Property="RowHeight" Value="28" />
        <Setter Property="SelectionMode" Value="Single" />
    </Style>

    <!-- Left-hand menu -->
    <Style x:Key="NavList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Foreground" Value="{StaticResource Brush.NavText}" />
                    <Setter Property="Padding" Value="18,10" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" BorderThickness="3,0,0,0" BorderBrush="Transparent">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#26333E" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#2C3A46" />
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#5DA9E9" />
                                        <Setter Property="Foreground" Value="White" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
